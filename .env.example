# =============================================================================
# Environment Configuration Template
# Copy this file to .env and fill in the values
# =============================================================================

# =============================================================================
# Shared Secrets (must match across frontend and backend)
# =============================================================================
BETTER_AUTH_SECRET=your-32-character-secret-key-here

# =============================================================================
# Frontend Configuration (frontend/.env.local)
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
BETTER_AUTH_URL=http://localhost:3000

# =============================================================================
# Backend Configuration (backend/.env)
# =============================================================================
# Get this from your Neon dashboard
DATABASE_URL=postgresql://user:pass@host.neon.tech/db?sslmode=require

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DAYS=7

# CORS - Update this to your frontend URL in production
CORS_ORIGINS=http://localhost:3000

# OpenAI API Key (get this from platform.openai.com)
# Leave empty to use mock responses instead of real AI
OPENAI_API_KEY=your-openai-api-key-here
