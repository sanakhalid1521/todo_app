# Environment Variables for Vercel Deployment

# Backend API URL (will be set by Vercel during deployment)
NEXT_PUBLIC_API_BASE_URL=https://your-vercel-project.vercel.app/api

# Auth secret (set in Vercel dashboard)
BETTER_AUTH_SECRET=your-32-character-secret-key-here

# Database URL (using Neon Postgres for production)
DATABASE_URL=postgresql://username:password@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DAYS=7

# CORS Origins (Vercel deployment URL)
CORS_ORIGINS=https://your-vercel-project.vercel.app

# Optional: OpenAI API key for AI features (set in Vercel dashboard if needed)
# OPENAI_API_KEY=your-openai-key-here