# Database URL for Neon Serverless PostgreSQL (replace with your actual Neon connection string when you have one)
# DATABASE_URL=postgresql://username:password@ep-xxx.us-east-1.aws.neon.tech/dbname

# Local development database (currently active)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/todo_app

BETTER_AUTH_SECRET=your-very-secure-32-character-secret-key-here-12345
OPENAI_API_KEY=your-openai-api-key-here

# Production environment variables
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_AUTH_SECRET=your-very-secure-32-character-secret-key-here-12345
CORS_ORIGINS=http://localhost:3001,http://frontend:3000,http://localhost:3000
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DAYS=7