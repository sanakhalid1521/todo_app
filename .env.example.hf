# OpenAI API Key for AI chatbot functionality
OPENAI_API_KEY=your_openai_api_key_here

# Database URL (Neon Serverless PostgreSQL)
DATABASE_URL=postgresql://username:password@ep-xxx.us-east-1.aws.neon.tech/dbname

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# JWT Secret for authentication (for production)
JWT_SECRET_KEY=your_jwt_secret_key_here

# CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000